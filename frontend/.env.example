# RiskGuard — Frontend (React + Vite)
# Copier ce fichier en .env et remplir les valeurs

# REQUIS — URL de l'API backend (sans trailing slash)
# Local : http://localhost:8000
# Render: https://riskguard-backend.onrender.com
VITE_API_URL=http://localhost:8000

# OPTIONNEL — Utiliser les mocks (true/false)
# VITE_USE_MOCKS=false
