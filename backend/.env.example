# RiskGuard — Backend (FastAPI)
# Copier ce fichier en .env et remplir les valeurs

# REQUIS — URL de connexion PostgreSQL
# Local : postgresql://user:password@localhost:5433/scoring_db
# Neon  : postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/scoring_db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5433/scoring_db

# REQUIS — Clé secrète JWT (minimum 32 caractères, générer avec `openssl rand -hex 32`)
SECRET_KEY=change_me_generate_a_random_key

# OPTIONNEL — Mode debug (false en production).
# DEBUG=true est REFUSÉ avec une base distante (Neon/Render).
# DEBUG=false

# OPTIONNEL — Origines CORS supplémentaires (séparées par des virgules)
# Ex: https://riskguard.vercel.app,https://riskguard-staging.vercel.app
# CORS_ORIGINS=https://riskguard.vercel.app

# OPTIONNEL — Pool de connexions (Neon limite à ~50 connections)
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
